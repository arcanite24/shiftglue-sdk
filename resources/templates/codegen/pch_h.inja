#define REX_UNIMPLEMENTED(addr, opcode) \
  throw std::runtime_error("Unimplemented PPC instruction: " opcode)

#define REX_QUERY_TIMEBASE() rex::chrono::Clock::QueryGuestTickCount()

//=============================================================================
// Setjmp/Longjmp
//=============================================================================

inline std::unordered_map<u32, jmp_buf>& get_jmp_buf_map() {
  static thread_local std::unordered_map<u32, jmp_buf> map;
  return map;
}

#define ppc_setjmp(guest_buf_addr) (setjmp(::get_jmp_buf_map()[(guest_buf_addr)]))

[[noreturn]] inline void ppc_longjmp(u32 guest_buf_addr, int val) {
  auto& map = get_jmp_buf_map();
  auto it = map.find(guest_buf_addr);
  if (it != map.end()) {
    longjmp(it->second, val);
  }
  std::abort();
}

//=============================================================================
// Trap Handling
//=============================================================================

inline void ppc_trap(PPCContext& ctx, u8* base, u16 trap_type) {
  switch (trap_type) {
    case 20:
    case 26: {
      auto str = REX_LOAD_STRING(ctx.r3.u32, ctx.r4.u16);
      REXCPU_DEBUG("(service trap) {}", str);
      break;
    }
    case 0:
    case 22:
      REXCPU_WARN("tw/td trap hit (type {})", trap_type);
      break;
    case 25:
      break;
    default:
      REXCPU_WARN("Unknown trap type {}", trap_type);
      break;
  }
}

//=============================================================================
// Interrupt Locks
//=============================================================================

// mtmsrd r13 disables interrupts; the runtime maps those sections onto the
// global critical region. mfmsr reports this thread's state without locking.
#define REX_CHECK_GLOBAL_LOCK() rex::thread::global_critical_region::GuestCheck()
#define REX_ENTER_GLOBAL_LOCK() rex::thread::global_critical_region::GuestEnter()
#define REX_ENTER_GLOBAL_LOCK_RESERVATION() \
  rex::thread::global_critical_region::GuestEnterReservation()
#define REX_LEAVE_GLOBAL_LOCK() rex::thread::global_critical_region::GuestLeave()

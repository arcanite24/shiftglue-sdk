//=============================================================================
// ABI poison checks (abi_poison_checks, checking builds only)
//=============================================================================

// Emitted around every direct and indirect guest call when the generator ran
// with abi_poison_checks: the caller snapshots the PowerPC non-volatile
// registers before the call, checks after it that the callee preserved them,
// and overwrites the volatile registers the ABI leaves dead at a return with
// poison, so a caller that still reads one changes the route results.
#define REX_ABI_POISON_PRE(site) ::rex::ppc::AbiPoisonPreCall(ctx, (site))
#define REX_ABI_POISON_POST(site) ::rex::ppc::AbiPoisonPostCall(ctx, (site))
// host_local_lr under abi_poison_checks: the guest LR slot holds a poison that
// names the function, and every reload of the local checks it is still there.
#define REX_LR_SLOT_POISON(function) ::rex::ppc::AbiPoisonLrSlotValue(function)
#define REX_LR_SLOT_CHECK(function, site, value) \
  ::rex::ppc::AbiPoisonLrSlotCheck((function), (site), (value))

// Probe build (call_probes): a counter per function entry and the targets of
// every indirect call site, written to probe.json at shutdown (rex/ppc/probe.h).
#define REX_PROBE_CALL(site) ::rex::ppc::ProbeCall(REX_CODE_BASE, REX_CODE_SIZE, (site))
#define REX_PROBE_INDIRECT(site, target) ::rex::ppc::ProbeIndirect((site), (target))


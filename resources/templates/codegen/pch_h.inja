#define REX_REF_STORE_U64(x, y)                                                                ::rex::ppc::RefStore<u64>((volatile u64*)(base + (u32)(x) + REX_PHYS_HOST_OFFSET(x)), (u32)(x),                             __builtin_bswap64(y))

